# Backend base URL, including the /api prefix.
# Vite picks the file by mode:
#   .env.development → npm run dev        (local backend)
#   .env.production  → npm run build, npm run dev:live (Render backend)
# For a personal override that isn't committed, create .env.development.local
# or .env.production.local with the same key.
VITE_API_BASE_URL=http://localhost:5000/api

# Google AdSense (optional). Without VITE_ADSENSE_CLIENT no ads load and <AdSlot /> renders nothing in production.
# Your publisher id, from AdSense → Account → Settings:
VITE_ADSENSE_CLIENT=ca-pub-3328927129991313
# Default ad unit id, used by <AdSlot /> when no `slot` prop is passed (AdSense → Ads → By ad unit):
VITE_ADSENSE_SLOT=
# Set to true while testing so AdSense serves test ads and doesn't count impressions:
VITE_ADSENSE_TEST=false
